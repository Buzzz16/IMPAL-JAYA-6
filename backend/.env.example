# ==============================================================================
# KONFIGURASI ENVIRONMENT BACKEND EXPRESS.JS & POSTGRESQL — POLUSEE WEB PLATFORM
# Salin file ini menjadi backend/.env dengan command:
#   cp backend/.env.example backend/.env
# ==============================================================================

PORT=5000
NODE_ENV=development

# 1. Konfigurasi Koneksi Basis Data PostgreSQL (SKPL Bab 2.4 & Lampiran B)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=polusee_db
DB_USER=postgres
DB_PASSWORD=postgres

# 2. Konfigurasi Keamanan JWT (SKPL NFR-03 Role-Based Access Control)
JWT_SECRET=polusee_super_secret_jwt_key_2025
JWT_EXPIRES_IN=7d

# 3. [EXTERNAL API] Konfigurasi API Kualitas Udara Eksternal (WAQI / AQICN API)
# Daftar token gratis di: https://aqicn.org/data-platform/token/
ENABLE_EXTERNAL_AQI_API=false
AQICN_API_BASE_URL=https://api.waqi.info
AQICN_API_TOKEN=MASUKKAN_TOKEN_WAQI_AQICN_DI_SINI

# 4. [EXTERNAL API] OpenWeatherMap Air Pollution API (Opsional)
ENABLE_OPENWEATHER_API=false
OPENWEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_API_KEY=MASUKKAN_API_KEY_OPENWEATHER_DI_SINI

# 5. [EXTERNAL API] OpenStreetMap Nominatim Geocoding API
OSM_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
