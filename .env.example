# ==============================================================================
# KONFIGURASI ENVIRONMENT VARIABLES — POLUSEE WEB PLATFORM (FRONTEND VUE.JS)
# Salin file ini menjadi .env dengan perintah:
#   cp .env.example .env
# ==============================================================================

# 1. URL Backend Express.js (REST API Internal PoluSee)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_BACKEND_URL=http://localhost:5000

# 2. [EXTERNAL API] Layanan Data AQI Real-Time Eksternal (WAQI / AQICN API)
# Daftar token gratis di: https://aqicn.org/data-platform/token/
# Masukkan token di bawah ini dan ubah VITE_ENABLE_EXTERNAL_AQI_API=true
VITE_ENABLE_EXTERNAL_AQI_API=false
VITE_AQICN_API_BASE_URL=https://api.waqi.info
VITE_AQICN_API_TOKEN=MASUKKAN_TOKEN_WAQI_AQICN_ANDA_DI_SINI

# 3. [EXTERNAL API] Layanan Cuaca & Polutan Udara (OpenWeatherMap Air Pollution API)
# Daftar API key di: https://openweathermap.org/api/air-pollution
VITE_ENABLE_OPENWEATHER_API=false
VITE_OPENWEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
VITE_OPENWEATHER_API_KEY=MASUKKAN_API_KEY_OPENWEATHER_ANDA_DI_SINI

# 4. [EXTERNAL API] OpenStreetMap API (Tile Server & Nominatim Geocoding/Reverse Geocoding)
# Tidak memerlukan API Key berbayar (Open-Source), namun dapat disesuaikan jika memakai tile server kustom
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OSM_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
