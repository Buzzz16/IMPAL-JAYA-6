# ==============================================================================
# KONFIGURASI ENVIRONMENT BACKEND EXPRESS.JS & POSTGRESQL / SUPABASE CLOUD
# File: backend/.env.example
# Salin file ini menjadi backend/src/.env.local (atau backend/.env):
#   cp backend/.env.example backend/src/.env.local
# ==============================================================================

PORT=5000
NODE_ENV=development

# ==============================================================================
# 1. KONFIGURASI BASIS DATA POSTGRESQL / SUPABASE CLOUD (SKPL Bab 2.4 & Lampiran B)
# ==============================================================================
# OPSI A (Rekomendasi Supabase): Cukup gunakan Connection String URI (Transaction Pooler):
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD_ANDA@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# OPSI B (Parameter manual jika memakai PostgreSQL lokal / tanpa DATABASE_URL):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=polusee_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# ==============================================================================
# 2. KONFIGURASI KEAMANAN JWT (SKPL NFR-03 Role-Based Access Control)
# ==============================================================================
JWT_SECRET=polusee_super_secret_jwt_key_2025
JWT_EXPIRES_IN=7d

# ==============================================================================
# 3. [EXTERNAL API] IQAir AirVisual API (Kualitas Udara & Cuaca Real-Time)
# ==============================================================================
ENABLE_IQAIR_API=true
IQAIR_API_BASE_URL=https://api.airvisual.com/v2
IQAIR_API_KEY=MASUKKAN_API_KEY_IQAIR_ANDA_DI_SINI

# ==============================================================================
# 4. [EXTERNAL API] Layanan Data AQI Real-Time Eksternal (WAQI / AQICN API)
# ==============================================================================
# Daftar token gratis di: https://aqicn.org/data-platform/token/
ENABLE_EXTERNAL_AQI_API=false
AQICN_API_BASE_URL=https://api.waqi.info
AQICN_API_TOKEN=MASUKKAN_TOKEN_WAQI_AQICN_DI_SINI

# ==============================================================================
# 5. [EXTERNAL API] OpenWeatherMap Air Pollution API (Opsional)
# ==============================================================================
# Daftar API key di: https://openweathermap.org/api/air-pollution
ENABLE_OPENWEATHER_API=false
OPENWEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_API_KEY=MASUKKAN_API_KEY_OPENWEATHER_DI_SINI

# ==============================================================================
# 6. [EXTERNAL API] OpenStreetMap Nominatim Geocoding API
# ==============================================================================
OSM_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
