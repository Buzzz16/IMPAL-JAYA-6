{
  "name": "polusee-web-platform",
  "private": true,
  "version": "2.0.0",
  "description": "PoluSee Web Platform - Aplikasi Pemantau dan Penghimbau Kualitas Udara (Vue.js, Express.js, PostgreSQL, OpenStreetMap API) mengacu pada SKPL-1000 Revisi C",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "vite",
    "dev:backend": "node --watch backend/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node backend/server.js",
    "db:schema": "psql -U postgres -d polusee_db -f database/schema.sql",
    "db:seed": "psql -U postgres -d polusee_db -f database/seed.sql",
    "db:init": "psql -U postgres -d polusee_db -f database/schema.sql && psql -U postgres -d polusee_db -f database/seed.sql"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.2.0"
  }
}
